{
    "name": "fittrack-monorepo",
    "version": "1.0.0",
    "lockfileVersion": 3,
    "requires": true,
    "packages": {
        "apps/feature-x": {
            "version": "1.0.0",
            "license": "ISC",
            "dependencies": {
                "@fittrack/ui-components": "*",
                "@fittrack/utils": "*"
            }
        },
        "apps/feature-y": {
            "version": "1.0.0",
            "license": "ISC",
            "dependencies": {
                "@fittrack/ui-components": "*",
                "@fittrack/utils": "*"
            }
        },
        "node_modules/@fittrack/ui-components": {
            "resolved": "packages/ui-components",
