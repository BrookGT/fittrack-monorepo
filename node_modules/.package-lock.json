        },
        "node_modules/@fittrack/utils": {
            "resolved": "packages/utils",
            "link": true
        },
        "node_modules/feature-x": {
            "resolved": "apps/feature-x",
            "link": true
        },
        "node_modules/feature-y": {
            "resolved": "apps/feature-y",
            "link": true
        },
        "packages/ui-components": {
            "name": "@fittrack/ui-components",
            "version": "1.0.0",
            "license": "ISC"
